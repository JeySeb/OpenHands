#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Fail fast y errores visibles
set -euo pipefail

# --- Asegurar Node/npm disponibles en hooks no interactivos ---
# Si usas NVM (lo parece por tu which npm), expón esa versión al PATH:
if [ -f "$HOME/.nvm/versions/node/v22.16.0/bin/npm" ]; then
  export PATH="$HOME/.nvm/versions/node/v22.16.0/bin:$PATH"
fi
# (Opcional) si tienes .nvmrc en el repo:
# if [ -f ".nvmrc" ]; then
#   NODE_VER="$(cat .nvmrc)"
#   [ -f "$HOME/.nvm/versions/node/$NODE_VER/bin/npm" ] && \
#     export PATH="$HOME/.nvm/versions/node/$NODE_VER/bin:$PATH"
# fi

# --- Asegurar Poetry (si lo instalaste vía pipx/installer) ---
# Añade rutas típicas de Windows si hiciera falta (ajusta si no las usas):
export PATH="$HOME/.local/bin:$PATH"  # pipx/poetry en Linux/Git Bash suele vivir aquí

# Guarda y vuelve al root del repo de forma segura
REPO_ROOT="$(git rev-parse --show-toplevel)"
pushd "$REPO_ROOT" >/dev/null

echo "Running frontend checks..."
pushd frontend >/dev/null
# Lint (evita rutas absolutas; usa npm/npx a secas)
npm run -s lint
npm run -s check-translation-completeness
# No reinstales paquetes aquí. Solo ejecuta lo que ya esté instalado.
npx --no-install lint-staged
popd >/dev/null

echo "Running backend pre-commit..."
# Limita paths como en tu comando original
poetry run pre-commit run \
  --files openhands/**/* evaluation/**/* tests/**/* \
  --show-diff-on-failure \
  --config ./dev_config/python/.pre-commit-config.yaml

popd >/dev/null